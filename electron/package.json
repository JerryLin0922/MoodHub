{
  "name": "moodhub-electron",
  "version": "0.2.0",
  "description": "MoodHub desktop shell (Electron)",
  "homepage": "https://github.com/JerryLin0922/MoodHub",
  "author": {
    "name": "Jerry Lin",
    "email": "jerrylin0922@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.moodhub.app",
    "productName": "MoodHub",
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*"
    ],
    "directories": {
      "output": "../release",
      "buildResources": "../build"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "MoodHub Dev <jerrylin0922@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../build/icon.png",
      "category": "public.app-category.healthcare-fitness"
    }
  },
  "dependencies": {
    "fs-extra": "^8.1.0"
  }
}
