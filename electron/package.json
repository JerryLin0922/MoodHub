{
  "name": "moodhub-electron",
  "version": "0.2.0",
  "description": "MoodHub desktop shell (Electron)",
  "homepage": "https://github.com/JerryLin0922/MoodHub",
  "author": {
    "name": "Jerry Lin",
    "email": "jerrylin0922@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5"
  },
  "scripts": {
    "pack:win:arm64": "npx electron-builder --win nsis portable --arm64",
    "pack:win:x64": "npx electron-builder --win nsis portable --x64",
    "pack:win:ia32": "npx electron-builder --win nsis portable --ia32",
    "pack:mac": "npx electron-builder --mac dmg zip",
    "pack:linux": "npx electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.moodhub.app",
    "productName": "MoodHub",
    "files": ["main.js", "preload.js", "health-ipc.js", "health-winrt.ps1", "native/**/*", "../dist/**/*"],
    "directories": {
      "output": "../release",
      "buildResources": "../build"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "MoodHub Dev <jerrylin0922@users.noreply.github.com>"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../build/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "../build/icon.png",
      "category": "public.app-category.healthcare-fitness"
    }
  }
}
